Q.2- Write a C program to find a peak element in an array using Binary Search with O(log n) time complexity. A peak element is greater than its neighbors.
#include <stdio.h>

int findPeak(int nums[], int n)
{
    int low = 0, high = n - 1;

    while(low < high)
    {
        int mid = low + (high - low) / 2;

        if(nums[mid] > nums[mid + 1])
            high = mid;
        else
            low = mid + 1;
    }

    return low;
}

int main()
{
    int n, i;

    scanf("%d", &n);
    int nums[n];

    for(i = 0; i < n; i++)
        scanf("%d", &nums[i]);

    printf("%d", findPeak(nums, n));

    return 0;
}
