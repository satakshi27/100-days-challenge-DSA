Q.2- Write a C program to find the minimum element in a sorted rotated array using Binary Search in O(log n) time.
#include <stdio.h>

int findMin(int nums[], int n)
{
    int low = 0, high = n - 1;

    while(low < high)
    {
        int mid = low + (high - low) / 2;

        if(nums[mid] > nums[high])
            low = mid + 1;
        else
            high = mid;
    }

    return nums[low];
}

int main()
{
    int n, i;

    scanf("%d", &n);
    int nums[n];

    for(i = 0; i < n; i++)
        scanf("%d", &nums[i]);

    printf("%d", findMin(nums, n));

    return 0;
}
