Q.2- Given a non-negative integer x, find and print the square root of x rounded down to the nearest integer without using built-in sqrt/pow.
#include <stdio.h>

int mySqrt(int x)
{
    long long left = 0, right = x, ans = 0, mid;

    while(left <= right)
    {
        mid = (left + right) / 2;

        if(mid * mid == x)
            return mid;
        else if(mid * mid < x)
        {
            ans = mid;
            left = mid + 1;
        }
        else
            right = mid - 1;
    }

    return ans;
}

int main()
{
    int x;
    scanf("%d", &x);

    printf("%d", mySqrt(x));

    return 0;
}
