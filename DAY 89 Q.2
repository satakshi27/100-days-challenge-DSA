Q.2- Find minimum ship capacity to deliver all packages within given days (order must be maintained).
int canShip(int* weights, int n, int days, int cap) {
    int d = 1, sum = 0;

    for (int i = 0; i < n; i++) {
        if (sum + weights[i] > cap) {
            d++;
            sum = 0;
        }
        sum += weights[i];
    }

    return d <= days;
}

int shipWithinDays(int* weights, int weightsSize, int days) {
    int left = 0, right = 0;

    for (int i = 0; i < weightsSize; i++) {
        if (weights[i] > left) left = weights[i];
        right += weights[i];
    }

    int ans = right;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        if (canShip(weights, weightsSize, days, mid)) {
            ans = mid;
            right = mid - 1;
        } else {
            left = mid + 1;
        }
    }

    return ans;
}
