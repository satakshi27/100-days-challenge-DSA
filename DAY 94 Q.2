Q.2- Sort arr1 based on the order of arr2; remaining elements in ascending order.
#include <stdlib.h>

int cmp(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

int* relativeSortArray(int* arr1, int arr1Size, int* arr2, int arr2Size, int* returnSize) {
    int count[1001] = {0};

    for (int i = 0; i < arr1Size; i++) count[arr1[i]]++;

    int* result = (int*)malloc(arr1Size * sizeof(int));
    int idx = 0;

    for (int i = 0; i < arr2Size; i++) {
        while (count[arr2[i]] > 0) {
            result[idx++] = arr2[i];
            count[arr2[i]]--;
        }
    }

    for (int i = 0; i <= 1000; i++) {
        while (count[i] > 0) {
            result[idx++] = i;
            count[i]--;
        }
    }

    *returnSize = arr1Size;
    return result;
}
