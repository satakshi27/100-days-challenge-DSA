Q.2- Find minimum meeting rooms required for given intervals.
#include <stdlib.h>

int cmpStart(const void* a, const void* b) {
    return ((int*)a)[0] - ((int*)b)[0];
}

int cmpEnd(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

int minMeetingRooms(int** intervals, int intervalsSize, int* intervalsColSize) {
    if (intervalsSize == 0) return 0;

    int* start = (int*)malloc(intervalsSize * sizeof(int));
    int* end = (int*)malloc(intervalsSize * sizeof(int));

    for (int i = 0; i < intervalsSize; i++) {
        start[i] = intervals[i][0];
        end[i] = intervals[i][1];
    }

    qsort(start, intervalsSize, sizeof(int), cmpEnd);
    qsort(end, intervalsSize, sizeof(int), cmpEnd);

    int i = 0, j = 0, rooms = 0, maxRooms = 0;

    while (i < intervalsSize) {
        if (start[i] < end[j]) {
            rooms++;
            if (rooms > maxRooms) maxRooms = rooms;
            i++;
        } else {
            rooms--;
            j++;
        }
    }

    return maxRooms;
}
