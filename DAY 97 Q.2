Q.2- Find minimum meeting rooms needed (start == end allowed).
#include <stdio.h>
#include <stdlib.h>

int cmp(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

int minMeetingRooms(int start[], int end[], int n) {
    qsort(start, n, sizeof(int), cmp);
    qsort(end, n, sizeof(int), cmp);

    int i = 0, j = 0, rooms = 0, maxRooms = 0;

    while (i < n) {
        if (start[i] < end[j]) {
            rooms++;
            if (rooms > maxRooms) maxRooms = rooms;
            i++;
        } else {
            rooms--;
            j++;
        }
    }

    return maxRooms;
}

int main() {
    int n;
    scanf("%d", &n);

    int start[n], end[n];
    for (int i = 0; i < n; i++) scanf("%d", &start[i]);
    for (int i = 0; i < n; i++) scanf("%d", &end[i]);

    printf("%d", minMeetingRooms(start, end, n));
    return 0;
}
