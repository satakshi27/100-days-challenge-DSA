Q.1- Write a C program to check whether a given matrix is symmetric or not.
#include <stdio.h>

int main() {
    int m, n;
    int a[100][100];
    int i, j, flag = 1;

    // Input rows and columns
    scanf("%d %d", &m, &n);

    // Check if matrix is square
    if (m != n) {
        printf("Not a Symmetric Matrix");
        return 0;
    }

    // Input matrix elements
    for(i = 0; i < m; i++) {
        for(j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    // Check symmetry
    for(i = 0; i < m; i++) {
        for(j = 0; j < n; j++) {
            if(a[i][j] != a[j][i]) {
                flag = 0;
                break;
            }
        }
        if(flag == 0)
            break;
    }

    // Output result
    if(flag == 1)
        printf("Symmetric Matrix");
    else
        printf("Not a Symmetric Matrix");

    return 0;
}
