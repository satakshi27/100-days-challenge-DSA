Q.2- Write a program to check whether a given matrix is a Toeplitz matrix
#include <stdio.h>

int main() {
    int m, n;
    int a[20][20];
    int i, j, flag = 1;

    // Input size
    scanf("%d %d", &m, &n);

    // Input matrix
    for(i = 0; i < m; i++) {
        for(j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    // Check Toeplitz condition
    for(i = 1; i < m; i++) {
        for(j = 1; j < n; j++) {
            if(a[i][j] != a[i-1][j-1]) {
                flag = 0;
                break;
            }
        }
        if(flag == 0)
            break;
    }

    // Output result
    if(flag == 1)
        printf("true");
    else
        printf("false");

    return 0;
}
