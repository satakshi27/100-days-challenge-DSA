Q.1- Write a C program to print the elements of a given matrix in spiral order (clockwise direction).
#include <stdio.h>

int main() {
    int r, c;
    int a[100][100];
    int top = 0, bottom, left = 0, right;
    int i, j;

    scanf("%d %d", &r, &c);

    for(i = 0; i < r; i++)
        for(j = 0; j < c; j++)
            scanf("%d", &a[i][j]);

    bottom = r - 1;
    right = c - 1;

    while(top <= bottom && left <= right) {

        for(i = left; i <= right; i++)
            printf("%d ", a[top][i]);
        top++;

        for(i = top; i <= bottom; i++)
            printf("%d ", a[i][right]);
        right--;

        if(top <= bottom) {
            for(i = right; i >= left; i--)
                printf("%d ", a[bottom][i]);
            bottom--;
        }

        if(left <= right) {
            for(i = bottom; i >= top; i--)
                printf("%d ", a[i][left]);
            left++;
        }
    }

    return 0;
}
