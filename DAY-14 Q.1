Q.1- Write a C program to check whether a given square matrix is an Identity Matrix.
#include <stdio.h>

int main() {
    int n;
    int a[100][100];
    int i, j, flag = 1;

    scanf("%d", &n);

    // Input matrix
    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    // Check Identity Matrix
    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            if(i == j && a[i][j] != 1)
                flag = 0;
            else if(i != j && a[i][j] != 0)
                flag = 0;
        }
    }

    // Output result
    if(flag == 1)
        printf("Identity Matrix");
    else
        printf("Not an Identity Matrix");

    return 0;
}
