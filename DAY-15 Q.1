Q.1- Write a C program to find the sum of primary diagonal elements of a matrix.
#include <stdio.h>

int main() {
    int m, n;
    int a[100][100];
    int i, j, sum = 0;

    scanf("%d %d", &m, &n);

    for(i = 0; i < m; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    // Sum of primary diagonal
    for(i = 0; i < m && i < n; i++) {
        sum += a[i][i];
    }

    printf("%d", sum);

    return 0;
}
