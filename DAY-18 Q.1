Q.1- Write a C program to rotate an array to the right by K positions.
#include <stdio.h>

void reverse(int a[], int s, int e) {
    int t;
    while(s < e) {
        t = a[s];
        a[s] = a[e];
        a[e] = t;
        s++;
        e--;
    }
}

int main() {
    int n, k, a[100], i;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &k);

    k = k % n;

    reverse(a, 0, n - 1);
    reverse(a, 0, k - 1);
    reverse(a, k, n - 1);

    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
