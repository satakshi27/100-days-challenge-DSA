Q.1- Given an array of n integers, count the number of subarrays whose sum is equal to 0.
#include <stdio.h>

int main() {
    int n, count = 0;
    scanf("%d", &n);

    int arr[n];

    for(int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    for(int i = 0; i < n; i++) {
        int sum = 0;
        for(int j = i; j < n; j++) {
            sum += arr[j];
            if(sum == 0)
                count++;
        }
    }

    printf("%d", count);

    return 0;
}
