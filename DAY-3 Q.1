Q.1-Implement linear search to find key k in an array. Count and display the number of comparisons performed.
#include <stdio.h>

int main()
{
    int n, k, i, found = 0, comparisons = 0;
    scanf("%d", &n);

    int a[n];

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &k);

    for(i = 0; i < n; i++)
    {
        comparisons++;
        if(a[i] == k)
        {
            printf("Found at index %d\n", i);
            found = 1;
            break;
        }
    }

    if(!found)
        printf("Not Found\n");

    printf("Comparisons = %d", comparisons);

    return 0;
}
