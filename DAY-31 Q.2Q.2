Q.2-Check if a string of brackets is valid using a stack.
#include <stdio.h>
#include <string.h>

#define MAX 10000

char stack[MAX];
int top = -1;

void push(char c) {
    stack[++top] = c;
}

char pop() {
    if (top == -1)
        return '\0';
    return stack[top--];
}

int isValid(char* s) {
    for (int i = 0; s[i] != '\0'; i++) {
        char ch = s[i];

        if (ch == '(' || ch == '{' || ch == '[') {
            push(ch);
        } else {
            char t = pop();

            if ((ch == ')' && t != '(') ||
                (ch == '}' && t != '{') ||
                (ch == ']' && t != '['))
                return 0;
        }
    }

    return top == -1;
}

int main() {
    char s[MAX];
    scanf("%s", s);

    if (isValid(s))
        printf("true");
    else
        printf("false");

    return 0;
}
