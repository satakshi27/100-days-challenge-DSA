Q.2-Evaluate the value of an arithmetic expression given in Reverse Polish Notation (Postfix form) using a stack.
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int stack[10000];
int top = -1;

void push(int x) {
    stack[++top] = x;
}

int pop() {
    return stack[top--];
}

int main() {
    int n;
    scanf("%d", &n);

    char tokens[10000][20];

    for (int i = 0; i < n; i++) {
        scanf("%s", tokens[i]);
    }

    for (int i = 0; i < n; i++) {
        if (strcmp(tokens[i], "+") == 0) {
            int b = pop();
            int a = pop();
            push(a + b);
        } 
        else if (strcmp(tokens[i], "-") == 0) {
            int b = pop();
            int a = pop();
            push(a - b);
        } 
        else if (strcmp(tokens[i], "*") == 0) {
            int b = pop();
            int a = pop();
            push(a * b);
        } 
        else if (strcmp(tokens[i], "/") == 0) {
            int b = pop();
            int a = pop();
            push(a / b);
        } 
        else {
            push(atoi(tokens[i]));
        }
    }

    printf("%d\n", pop());

    return 0;
}
