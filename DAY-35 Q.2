Q.2-Implement a Queue (FIFO) using two stacks. Support operations: push, pop, peek, and empty.
#include <stdio.h>
#include <stdbool.h>

int s1[100], s2[100];
int top1 = -1, top2 = -1;

void push1(int x) {
    s1[++top1] = x;
}

int pop1() {
    return s1[top1--];
}

void push2(int x) {
    s2[++top2] = x;
}

int pop2() {
    return s2[top2--];
}

bool empty() {
    return (top1 == -1 && top2 == -1);
}

void push(int x) {
    push1(x);
}

int pop() {
    if (top2 == -1) {
        while (top1 != -1)
            push2(pop1());
    }
    return pop2();
}

int peek() {
    if (top2 == -1) {
        while (top1 != -1)
            push2(pop1());
    }
    return s2[top2];
}

int main() {
    push(1);
    push(2);
    printf("%d\n", peek());
    printf("%d\n", pop());
    printf("%s", empty() ? "true" : "false");
    return 0;
}
