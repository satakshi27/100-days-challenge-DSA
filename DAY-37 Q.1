Q.1- Implement a Priority Queue using an array where smaller values have higher priority. Support operations: insert, delete, and peek.
#include <stdio.h>
#include <string.h>

int pq[1000];
int size = 0;

void insert(int x) {
    pq[size++] = x;
}

int getMinIndex() {
    if (size == 0) return -1;

    int minIndex = 0;
    for (int i = 1; i < size; i++) {
        if (pq[i] < pq[minIndex]) {
            minIndex = i;
        }
    }
    return minIndex;
}

int deleteMin() {
    if (size == 0) return -1;

    int minIndex = getMinIndex();
    int val = pq[minIndex];

    for (int i = minIndex; i < size - 1; i++) {
        pq[i] = pq[i + 1];
    }
    size--;

    return val;
}

int peek() {
    if (size == 0) return -1;

    int minIndex = getMinIndex();
    return pq[minIndex];
}

int main() {
    int n, x;
    char op[10];

    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%s", op);

        if (strcmp(op, "insert") == 0) {
            scanf("%d", &x);
            insert(x);
        } 
        else if (strcmp(op, "delete") == 0) {
            printf("%d\n", deleteMin());
        } 
        else if (strcmp(op, "peek") == 0) {
            printf("%d\n", peek());
        }
    }

    return 0;
}
