Q.2-Design a class to find the kth largest element in a stream of integers. After each insertion, return the kth largest element.
#include <stdio.h>

int heap[10005];
int size = 0;
int k;

void swap(int *a, int *b) {
    int t = *a;
    *a = *b;
    *b = t;
}

void heapifyUp(int i) {
    while (i > 0 && heap[(i - 1) / 2] > heap[i]) {
        swap(&heap[(i - 1) / 2], &heap[i]);
        i = (i - 1) / 2;
    }
}

void heapifyDown(int i) {
    int smallest = i;
    int l = 2 * i + 1;
    int r = 2 * i + 2;

    if (l < size && heap[l] < heap[smallest])
        smallest = l;
    if (r < size && heap[r] < heap[smallest])
        smallest = r;

    if (smallest != i) {
        swap(&heap[i], &heap[smallest]);
        heapifyDown(smallest);
    }
}

void insert(int val) {
    heap[size] = val;
    heapifyUp(size);
    size++;
}

void removeMin() {
    heap[0] = heap[size - 1];
    size--;
    heapifyDown(0);
}

int add(int val) {
    if (size < k) {
        insert(val);
    } else if (val > heap[0]) {
        heap[0] = val;
        heapifyDown(0);
    }
    return heap[0];
}

int main() {
    k = 3;

    int nums[] = {4, 5, 8, 2};
    int n = 4;

    for (int i = 0; i < n; i++) {
        add(nums[i]);
    }

    printf("%d\n", add(3));
    printf("%d\n", add(5));
    printf("%d\n", add(10));
    printf("%d\n", add(9));
    printf("%d\n", add(4));

    return 0;
}
