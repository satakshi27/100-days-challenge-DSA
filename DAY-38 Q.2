Q.2-Given an array and a window size k, find the maximum element in each sliding window as it moves from left to right
#include <stdio.h>

int dq[100000];
int front = 0, rear = -1;

int main() {
    int n, k;
    scanf("%d", &n);

    int nums[100000];
    for (int i = 0; i < n; i++)
        scanf("%d", &nums[i]);

    scanf("%d", &k);

    for (int i = 0; i < n; i++) {
        if (front <= rear && dq[front] <= i - k)
            front++;

        while (front <= rear && nums[dq[rear]] < nums[i])
            rear--;

        dq[++rear] = i;

        if (i >= k - 1)
            printf("%d ", nums[dq[front]]);
    }

    return 0;
}
