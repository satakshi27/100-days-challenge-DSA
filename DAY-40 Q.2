Q.2-Given an array of daily temperatures, return an array such that each element tells how many days you must wait to get a warmer temperature. If no such day exists, return 0.
#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int temp[100000], res[100000], stack[100000];
    int top = -1;

    for (int i = 0; i < n; i++) {
        scanf("%d", &temp[i]);
        res[i] = 0;
    }

    for (int i = 0; i < n; i++) {
        while (top != -1 && temp[i] > temp[stack[top]]) {
            int idx = stack[top--];
            res[idx] = i - idx;
        }
        stack[++top] = i;
    }

    for (int i = 0; i < n; i++) {
        printf("%d ", res[i]);
    }

    return 0;
}
