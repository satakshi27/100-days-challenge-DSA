Q.1- Print the nodes visible when the binary tree is viewed from the right side
#include <stdio.h>
#include <stdlib.h>

struct Node{
    int data;
    struct Node *left,*right;
};

struct Node* newNode(int data){
    struct Node* node=(struct Node*)malloc(sizeof(struct Node));
    node->data=data;
    node->left=node->right=NULL;
    return node;
}

struct Node* build(int a[],int n){
    if(n==0||a[0]==-1) return NULL;
    struct Node* root=newNode(a[0]);
    struct Node* q[n];
    int f=0,r=0,i=1;
    q[r++]=root;
    while(i<n){
        struct Node* t=q[f++];
        if(a[i]!=-1){
            t->left=newNode(a[i]);
            q[r++]=t->left;
        }
        i++;
        if(i<n&&a[i]!=-1){
            t->right=newNode(a[i]);
            q[r++]=t->right;
        }
        i++;
    }
    return root;
}

void rightView(struct Node* root){
    if(!root) return;
    struct Node* q[100];
    int f=0,r=0;
    q[r++]=root;
    while(f<r){
        int s=r-f;
        for(int i=0;i<s;i++){
            struct Node* t=q[f++];
            if(i==s-1) printf("%d ",t->data);
            if(t->left) q[r++]=t->left;
            if(t->right) q[r++]=t->right;
        }
    }
}

int main(){
    int n;
    scanf("%d",&n);
    int a[n];
    for(int i=0;i<n;i++) scanf("%d",&a[i]);
    struct Node* root=build(a,n);
    rightView(root);
    return 0;
}
