Q.2- Move all zeros to the end while maintaining order of non-zero elements.
#include <stdio.h>

int main()
{
    int n;
    scanf("%d", &n);

    int nums[n];

    for(int i = 0; i < n; i++)
        scanf("%d", &nums[i]);

    int j = 0;

    for(int i = 0; i < n; i++)
    {
        if(nums[i] != 0)
        {
            nums[j] = nums[i];
            j++;
        }
    }

    for(int i = j; i < n; i++)
        nums[i] = 0;

    for(int i = 0; i < n; i++)
        printf("%d ", nums[i]);

    return 0;
}
