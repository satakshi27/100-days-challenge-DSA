Q.1- Check whether a given binary tree satisfies the Min-Heap property.
#include <stdio.h>

int isMinHeap(int a[],int n){
    for(int i=0;i<= (n-2)/2;i++){
        if(2*i+1<n && a[i]>a[2*i+1]) return 0;
        if(2*i+2<n && a[i]>a[2*i+2]) return 0;
    }
    return 1;
}

int main(){
    int n;
    scanf("%d",&n);

    int a[n];
    for(int i=0;i<n;i++) scanf("%d",&a[i]);

    if(isMinHeap(a,n)) printf("YES");
    else printf("NO");

    return 0;
}
