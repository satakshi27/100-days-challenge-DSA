Q.1-Detect cycle in directed graph using DFS and recursion stack.
#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int v;
    struct Node* next;
} Node;

Node* adj[100005];
int visited[100005], recStack[100005];

void addEdge(int u, int v) {
    Node* n = (Node*)malloc(sizeof(Node));
    n->v = v;
    n->next = adj[u];
    adj[u] = n;
}

int dfs(int v) {
    visited[v] = 1;
    recStack[v] = 1;

    Node* temp = adj[v];
    while (temp) {
        int u = temp->v;
        if (!visited[u]) {
            if (dfs(u))
                return 1;
        } else if (recStack[u]) {
            return 1;
        }
        temp = temp->next;
    }

    recStack[v] = 0;
    return 0;
}

int main() {
    int V, E;
    scanf("%d %d", &V, &E);

    for (int i = 0; i < V; i++) {
        adj[i] = NULL;
        visited[i] = 0;
        recStack[i] = 0;
    }

    int u, v;
    for (int i = 0; i < E; i++) {
        scanf("%d %d", &u, &v);
        addEdge(u, v);
    }

    for (int i = 0; i < V; i++) {
        if (!visited[i]) {
            if (dfs(i)) {
                printf("YES");
                return 0;
            }
        }
    }

    printf("NO");
    return 0;
}
