Q.2- Return course order to finish all courses (Topological Sort).
#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int v;
    struct Node* next;
} Node;

Node* adj[2005];
int visited[2005], recStack[2005], stack[2005];
int top = -1;

void addEdge(int u, int v) {
    Node* n = (Node*)malloc(sizeof(Node));
    n->v = v;
    n->next = adj[u];
    adj[u] = n;
}

int dfs(int v) {
    visited[v] = 1;
    recStack[v] = 1;

    Node* temp = adj[v];
    while (temp) {
        int u = temp->v;
        if (!visited[u]) {
            if (dfs(u))
                return 1;
        } else if (recStack[u]) {
            return 1;
        }
        temp = temp->next;
    }

    recStack[v] = 0;
    stack[++top] = v;
    return 0;
}

int main() {
    int numCourses, E;
    scanf("%d %d", &numCourses, &E);

    for (int i = 0; i < numCourses; i++) {
        adj[i] = NULL;
        visited[i] = 0;
        recStack[i] = 0;
    }

    int a, b;
    for (int i = 0; i < E; i++) {
        scanf("%d %d", &a, &b);
        addEdge(b, a);
    }

    for (int i = 0; i < numCourses; i++) {
        if (!visited[i]) {
            if (dfs(i)) {
                printf("[]");
                return 0;
            }
        }
    }

    printf("[");
    for (int i = top; i >= 0; i--) {
        printf("%d", stack[i]);
        if (i != 0) printf(",");
    }
    printf("]");

    return 0;
}
