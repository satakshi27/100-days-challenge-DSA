Q.1- Find shortest paths from source in weighted graph (Dijkstra using priority queue).
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

typedef struct Node {
    int v, w;
    struct Node* next;
} Node;

typedef struct {
    int vertex, dist;
} HeapNode;

Node* adj[100005];
int dist[100005], visited[100005];

void addEdge(int u, int v, int w) {
    Node* n = (Node*)malloc(sizeof(Node));
    n->v = v;
    n->w = w;
    n->next = adj[u];
    adj[u] = n;
}

void swap(HeapNode* a, HeapNode* b) {
    HeapNode temp = *a;
    *a = *b;
    *b = temp;
}

void heapifyUp(HeapNode heap[], int i) {
    while (i && heap[(i - 1) / 2].dist > heap[i].dist) {
        swap(&heap[i], &heap[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

void heapifyDown(HeapNode heap[], int size, int i) {
    int smallest = i;
    int l = 2 * i + 1, r = 2 * i + 2;

    if (l < size && heap[l].dist < heap[smallest].dist)
        smallest = l;
    if (r < size && heap[r].dist < heap[smallest].dist)
        smallest = r;

    if (smallest != i) {
        swap(&heap[i], &heap[smallest]);
        heapifyDown(heap, size, smallest);
    }
}

void push(HeapNode heap[], int* size, int v, int d) {
    heap[*size].vertex = v;
    heap[*size].dist = d;
    heapifyUp(heap, (*size)++);
}

HeapNode pop(HeapNode heap[], int* size) {
    HeapNode root = heap[0];
    heap[0] = heap[--(*size)];
    heapifyDown(heap, *size, 0);
    return root;
}

int main() {
    int V, E;
    scanf("%d %d", &V, &E);

    for (int i = 0; i < V; i++) {
        adj[i] = NULL;
        dist[i] = INT_MAX;
        visited[i] = 0;
    }

    int u, v, w;
    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &u, &v, &w);
        addEdge(u, v, w);
    }

    int src;
    scanf("%d", &src);

    HeapNode heap[100005];
    int size = 0;

    dist[src] = 0;
    push(heap, &size, src, 0);

    while (size > 0) {
        HeapNode node = pop(heap, &size);
        int u = node.vertex;

        if (visited[u]) continue;
        visited[u] = 1;

        Node* temp = adj[u];
        while (temp) {
            int v = temp->v, w = temp->w;
            if (!visited[v] && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                push(heap, &size, v, dist[v]);
            }
            temp = temp->next;
        }
    }

    for (int i = 0; i < V; i++)
        printf("%d ", dist[i]);

    return 0;
}
