Q.2- Find time for signal to reach all nodes.
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

typedef struct Node {
    int v, w;
    struct Node* next;
} Node;

Node* adj[105];
int dist[105], visited[105];

void addEdge(int u, int v, int w) {
    Node* n = (Node*)malloc(sizeof(Node));
    n->v = v;
    n->w = w;
    n->next = adj[u];
    adj[u] = n;
}

int main() {
    int E, n, k;
    scanf("%d %d %d", &E, &n, &k);

    for (int i = 1; i <= n; i++) {
        adj[i] = NULL;
        dist[i] = INT_MAX;
        visited[i] = 0;
    }

    int u, v, w;
    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &u, &v, &w);
        addEdge(u, v, w);
    }

    dist[k] = 0;

    for (int i = 1; i <= n; i++) {
        int min = INT_MAX, u = -1;

        for (int j = 1; j <= n; j++) {
            if (!visited[j] && dist[j] < min) {
                min = dist[j];
                u = j;
            }
        }

        if (u == -1) break;
        visited[u] = 1;

        Node* temp = adj[u];
        while (temp) {
            int v = temp->v, w = temp->w;
            if (dist[u] + w < dist[v])
                dist[v] = dist[u] + w;
            temp = temp->next;
        }
    }

    int ans = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == INT_MAX) {
            printf("-1");
            return 0;
        }
        if (dist[i] > ans)
            ans = dist[i];
    }

    printf("%d", ans);
    return 0;
}
