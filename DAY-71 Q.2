Q.2- Find the minimum total cost to connect all points.
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

int min(int a, int b) {
    return a < b ? a : b;
}

int manhattan(int x1, int y1, int x2, int y2) {
    return abs(x1 - x2) + abs(y1 - y2);
}

int minCostConnectPoints(int points[][2], int n) {
    int visited[n];
    int dist[n];

    for (int i = 0; i < n; i++) {
        visited[i] = 0;
        dist[i] = INT_MAX;
    }

    dist[0] = 0;
    int cost = 0;

    for (int i = 0; i < n; i++) {
        int u = -1;
        for (int j = 0; j < n; j++) {
            if (!visited[j] && (u == -1 || dist[j] < dist[u]))
                u = j;
        }

        visited[u] = 1;
        cost += dist[u];

        for (int v = 0; v < n; v++) {
            if (!visited[v]) {
                int d = manhattan(points[u][0], points[u][1], points[v][0], points[v][1]);
                dist[v] = min(dist[v], d);
            }
        }
    }

    return cost;
}

int main() {
    int n;
    scanf("%d", &n);

    int points[n][2];
    for (int i = 0; i < n; i++)
        scanf("%d %d", &points[i][0], &points[i][1]);

    printf("%d\n", minCostConnectPoints(points, n));

    return 0;
}
