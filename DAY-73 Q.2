Q.2- Find the redundant edge in a graph (originally a tree) whose removal makes it a tree again; if multiple exist, return the one appearing last.
#include <stdio.h>

int parent[1001];

int find(int x) {
    if (parent[x] != x)
        parent[x] = find(parent[x]);
    return parent[x];
}

int unionSet(int a, int b) {
    int pa = find(a);
    int pb = find(b);
    if (pa == pb)
        return 0;
    parent[pa] = pb;
    return 1;
}

int main() {
    int edges[][2] = {{1,2},{1,3},{2,3}};
    int n = 3;

    for (int i = 1; i <= n; i++)
        parent[i] = i;

    int resA = 0, resB = 0;

    for (int i = 0; i < n; i++) {
        if (!unionSet(edges[i][0], edges[i][1])) {
            resA = edges[i][0];
            resB = edges[i][1];
        }
    }

    printf("[%d,%d]", resA, resB);
    return 0;
}
