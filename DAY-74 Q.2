Q.2- Find the number of provinces (connected components) in a graph represented by an adjacency matrix.
#include <stdio.h>

int visited[200];

void dfs(int i, int n, int isConnected[][200]) {
    visited[i] = 1;
    for (int j = 0; j < n; j++) {
        if (isConnected[i][j] == 1 && !visited[j])
            dfs(j, n, isConnected);
    }
}

int main() {
    int n;
    scanf("%d", &n);

    int isConnected[200][200];

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &isConnected[i][j]);

    int count = 0;

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            dfs(i, n, isConnected);
            count++;
        }
    }

    printf("%d", count);
    return 0;
}
