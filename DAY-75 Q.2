Q.2- Check whether a given undirected graph is bipartite or not.
#include <stdio.h>

int graph[100][100], color[100];

int dfs(int node, int c, int n) {
    color[node] = c;
    for (int i = 0; i < n; i++) {
        if (graph[node][i]) {
            if (color[i] == -1) {
                if (!dfs(i, 1 - c, n))
                    return 0;
            } else if (color[i] == c)
                return 0;
        }
    }
    return 1;
}

int main() {
    int n;
    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    for (int i = 0; i < n; i++)
        color[i] = -1;

    for (int i = 0; i < n; i++) {
        if (color[i] == -1) {
            if (!dfs(i, 0, n)) {
                printf("false");
                return 0;
            }
        }
    }

    printf("true");
    return 0;
}
