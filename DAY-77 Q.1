Q.1- Given an undirected graph with n nodes and m edges, check whether the graph is CONNECTED or NOT CONNECTED using DFS or BFS.
#include <stdio.h>

#define MAX 100

int adj[MAX][MAX], visited[MAX];
int n;

void dfs(int v) {
    visited[v] = 1;
    for(int i = 1; i <= n; i++) {
        if(adj[v][i] == 1 && !visited[i]) {
            dfs(i);
        }
    }
}

int main() {
    int m, u, v;
    scanf("%d %d", &n, &m);

    for(int i = 0; i < m; i++) {
        scanf("%d %d", &u, &v);
        adj[u][v] = adj[v][u] = 1;
    }

    dfs(1);  // start from node 1

    for(int i = 1; i <= n; i++) {
        if(!visited[i]) {
            printf("NOT CONNECTED\n");
            return 0;
        }
    }

    printf("CONNECTED\n");
    return 0;
}
