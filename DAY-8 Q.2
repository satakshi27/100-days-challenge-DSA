Q.2- Check whether a number is a power of two.
#include <stdio.h>

int isPowerOfTwo(int n)
{
    if(n <= 0)
        return 0;

    return (n & (n - 1)) == 0;
}

int main()
{
    int n;
    scanf("%d", &n);

    if(isPowerOfTwo(n))
        printf("true");
    else
        printf("false");

    return 0;
}
