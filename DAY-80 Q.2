Q.2- Use Floyd–Warshall to compute all-pairs shortest paths, then count reachable cities for each node.
#include <stdio.h>

#define MAX 105
#define INF 1000000000

int main() {
    int n, m, threshold;
    int dist[MAX][MAX];

    scanf("%d %d", &n, &m);

    // Initialize matrix
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (i == j) dist[i][j] = 0;
            else dist[i][j] = INF;
        }
    }

    // Input edges
    for (int i = 0; i < m; i++) {
        int u, v, w;
        scanf("%d %d %d", &u, &v, &w);
        dist[u][v] = w;
        dist[v][u] = w;
    }

    scanf("%d", &threshold);

    // Floyd-Warshall
    for (int k = 0; k < n; k++) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (dist[i][k] + dist[k][j] < dist[i][j]) {
                    dist[i][j] = dist[i][k] + dist[k][j];
                }
            }
        }
    }

    int resultCity = -1, minCount = INF;

    for (int i = 0; i < n; i++) {
        int count = 0;

        for (int j = 0; j < n; j++) {
            if (i != j && dist[i][j] <= threshold) {
                count++;
            }
        }

        // Choose smaller count OR larger index in tie
        if (count <= minCount) {
            minCount = count;
            resultCity = i;
        }
    }

    printf("%d\n", resultCity);

    return 0;
}
