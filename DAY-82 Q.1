Q.1- Find lower bound (first ≥ x) and upper bound (first > x) in a sorted array.
#include <stdio.h>

int main() {
    int n, x;
    scanf("%d", &n);
    
    int arr[n];
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);
    
    scanf("%d", &x);

    int left = 0, right = n, mid;
    while (left < right) {
        mid = (left + right) / 2;
        if (arr[mid] < x)
            left = mid + 1;
        else
            right = mid;
    }
    int lb = left;

    left = 0, right = n;
    while (left < right) {
        mid = (left + right) / 2;
        if (arr[mid] <= x)
            left = mid + 1;
        else
            right = mid;
    }
    int ub = left;

    printf("%d %d", lb, ub);

    return 0;
}
