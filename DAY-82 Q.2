Q.2- Return index of target in sorted array, or its insert position (O(log n)).
#include <stdio.h>

int main() {
    int n, target;
    scanf("%d", &n);
    
    int nums[n];
    for (int i = 0; i < n; i++)
        scanf("%d", &nums[i]);
    
    scanf("%d", &target);

    int left = 0, right = n - 1, mid;

    while (left <= right) {
        mid = (left + right) / 2;
        if (nums[mid] == target) {
            printf("%d", mid);
            return 0;
        }
        else if (nums[mid] < target)
            left = mid + 1;
        else
            right = mid - 1;
    }

    printf("%d", left);
    return 0;
}
